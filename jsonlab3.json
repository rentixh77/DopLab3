                      "spec": {
                        "dataset": "cowrie",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\r\n  c.version AS `Клиент`,\r\n  COUNT(*) AS `Записей в clients`,\r\n  SUM(COALESCE(t.n, 0)) AS `Сессий`\r\nFROM clients c\r\nLEFT JOIN (\r\n  SELECT client, COUNT(*) AS n\r\n  FROM sessions\r\n  WHERE $__timeFilter(starttime)\r\n  GROUP BY client\r\n) t ON t.client = c.id\r\nWHERE c.version LIKE 'SSH-%'\r\nGROUP BY c.version\r\nORDER BY 3 DESC",
                        "sql": {
