                        "rawQuery": true,
                        "rawSql": "SELECT\r\n  g.countryName AS `Страна`,\r\n  SUM(t.n) AS `Сессий`\r\nFROM (\r\n  SELECT ip, COUNT(*) AS n\r\n  FROM sessions\r\n  WHERE $__timeFilter(starttime)\r\n  GROUP BY ip\r\n) t\r\nJOIN geo g ON g.ipAddress = t.ip\r\nWHERE g.countryName IS NOT NULL\r\nGROUP BY g.countryName\r\nORDER BY `Сессий` DESC\r\nLIMIT 10",
