                      "version": "v0",
                      "datasource": {
                        "name": "ag2sj7un7quioa"
                      },
                      "spec": {
                        "dataset": "cowrie",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\r\n  s.id AS `ID`,\r\n  s.ip AS `Сенсор`,\r\n  COALESCE(t.n, 0) AS `Сессий`,\r\n  t.first AS `Первая`,\r\n  t.last AS `Последняя`\r\nFROM sensors s\r\nLEFT JOIN (\r\n  SELECT\r\n    sensor,\r\n    COUNT(*) AS n,\r\n    MIN(starttime) AS first,\r\n    MAX(starttime) AS last\r\n  FROM sessions\r\n  WHERE $__timeFilter(starttime)\r\n  GROUP BY sensor\r\n) t ON t.sensor = s.id\r\nORDER BY s.id",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
