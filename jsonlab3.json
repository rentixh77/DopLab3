                        "rawQuery": true,
                        "rawSql": "SELECT\r\n  COALESCE(a.password, '(нет пароля)') AS `Пароль`,\r\n  COUNT(*) AS `Попыток`\r\nFROM geo g\r\nJOIN sessions s ON s.ip = g.ipAddress\r\nJOIN auth a ON a.session = s.id\r\nWHERE g.countryName = ${country:sqlstring}\r\n  AND $__timeFilter(s.starttime)\r\nGROUP BY a.password\r\nORDER BY `Попыток` DESC\r\nLIMIT 10",
